[Desktop Entry]
Type=Application
Name=ZapFast
GenericName=WhatsApp Client
Comment=A native WhatsApp client
Exec=zapfast
Icon=zapfast
Terminal=false
Categories=Network;InstantMessaging;Chat;
Keywords=whatsapp;chat;messaging;
StartupWMClass=zapfast
SingleMainWindow=true
Actions=quit;

[Desktop Action quit]
Name=Quit ZapFast
Exec=zapfast quit

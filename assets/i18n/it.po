msgstr ""
"Mette in pausa i lettori multimediali mentre registri un vocale e li "
"riprende dopo."

#: src/ui/settings.rs:399
msgid "Pause music while playing voice messages and videos"
msgstr "Metti in pausa la musica durante vocali e video"

#: src/ui/settings.rs:402
msgid ""

#: src/new_group.rs:190 src/ui/new_group.rs:452
msgid "Enter a name for the group."
msgstr "Masukkan nama untuk kumpulan ini."

#: src/new_group.rs:192
#, rust-format
msgid "A group name can have at most {count} characters."
msgstr "Nama kumpulan boleh mempunyai maksimum {count} aksara."

#: src/new_group.rs:196
msgid "Choose at least one person for the group."
msgstr "Pilih sekurang-kurangnya seorang untuk kumpulan ini."

#: src/new_group.rs:198
msgid "Connect to WhatsApp to create a group."
msgstr "Sambung ke WhatsApp untuk mencipta kumpulan."

#: src/new_group.rs:201
msgid ""
"WhatsApp did not answer in time. If the group does not appear shortly, try "
"again."
msgstr ""
"WhatsApp tidak menjawab dalam masa yang ditetapkan. Jika kumpulan tidak "
"muncul tidak lama lagi, cuba lagi."

#: src/new_group.rs:206
msgid "WhatsApp does not allow this account to create groups right now."
msgstr ""
"WhatsApp tidak membenarkan akaun ini mencipta kumpulan buat masa ini."

#: src/new_group.rs:211
msgid "You have created too many groups recently. Try again later."
msgstr ""
"Anda telah mencipta terlalu banyak kumpulan baru-baru ini. Cuba lagi "
"kemudian."

#: src/new_group.rs:216
msgid "WhatsApp did not accept this group's name or members."
msgstr "WhatsApp tidak menerima nama atau ahli kumpulan ini."

#: src/new_group.rs:219
msgid "Could not create the group. Try again."
msgstr "Tidak dapat mencipta kumpulan. Cuba lagi."

#: src/new_group.rs:258
#, rust-format
msgid ""
"{names} could not be added to the group. Their privacy settings may not "
"allow it."
msgstr ""
"{names} tidak dapat ditambah ke kumpulan. Tetapan privasi mereka mungkin "
"tidak membenarkannya."


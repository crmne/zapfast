msgstr "Ukončete ji z oznamovací oblasti nebo stisknutím Ctrl+Q."

msgid "Start at login"
msgstr "Spouštět při přihlášení"

msgid "Starts in the tray, without a window."
msgstr "Spustí se v oznamovací oblasti bez okna."

msgid "Check for updates"
msgstr "Kontrolovat aktualizace"


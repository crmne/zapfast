msgstr "este chat"

#: src/ui/dialogs.rs:785
msgid "Delete chat?"
msgstr "¿Eliminar chat?"

#: src/ui/dialogs.rs:788
msgid ""
"This deletes your chat with {name}, including all messages, on this computer"
" and on your phone. It cannot be undone."
msgstr ""
"Esto elimina tu chat con {name}, incluidos todos los mensajes, en este "
"equipo y en tu teléfono. No se puede deshacer."

#: src/ui/dialogs.rs:799 src/ui/dialogs.rs:1199
msgid "Delete"
msgstr "Eliminar"

#: src/ui/dialogs.rs:816
msgid "Clear chat?"
msgstr "¿Vaciar chat?"

#: src/ui/dialogs.rs:819
msgid ""
"This clears every message in your chat with {name}, including downloaded "
"media, on this computer and on your phone. The chat itself stays. It cannot "
"be undone."
msgstr ""
"Esto vacía todos los mensajes de tu chat con {name}, incluidos los archivos "
"descargados, en este equipo y en tu teléfono. El chat se conservará. No se "
"puede deshacer."


msgid "Import a pack"
msgstr "Importar um pacote"

#: src/ui/picker.rs:1373
msgid ""
"Paste a signal.art link from signalstickers.org, or open a .wastickers file."
msgstr ""
"Cole um link do signal.art do signalstickers.org ou abra um "
"arquivo .wastickers."

#: src/ui/picker.rs:1383

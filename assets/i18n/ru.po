#: src/ui/labels.rs:149
msgid "Manage labels"
msgstr "Управление метками"

#: src/ui/labels.rs:192
msgid "All chats"
msgstr "Все чаты"

#: src/ui/labels.rs:207 src/ui/labels.rs:247
msgid "Manage labels…"
msgstr "Управление метками…"

#: src/ui/labels.rs:283
msgid ""
"Labels stay on this computer. They do not reach your phone or anyone you "
"chat with."
msgstr ""
"Метки остаются на этом компьютере. Они не попадают ни на ваш телефон, ни к "
"собеседникам."

#: src/ui/labels.rs:304
msgid "New label"
msgstr "Новая метка"

#: src/ui/labels.rs:318
msgid "Create"
msgstr "Создать"

#: src/ui/labels.rs:348
msgid ""
"No labels yet. Create one above, then add chats to it from their right-click "
"menu."
msgstr ""
"Меток пока нет. Создайте метку выше, затем добавляйте чаты через их "
"контекстное меню."

#: src/ui/labels.rs:383
msgid "Next colour"
msgstr "Следующий цвет"

#: src/ui/labels.rs:432
#, rust-format
msgid "{} chat"
msgid_plural "{} chats"
msgstr[0] "{} чат"
msgstr[1] "{} чата"
msgstr[2] "{} чатов"

#: src/ui/labels.rs:453
msgid "Rename or recolour"
msgstr "Переименовать или сменить цвет"

#: src/ui/labels.rs:478
msgid "Delete this label. Its chats keep their messages."
msgstr "Удалить эту метку. Сообщения в её чатах останутся."

#: src/ui/picker.rs:1148
msgid "Recent"
msgstr "Недавние"

#: src/ui/picker.rs:1150
msgid "Add stickers"
msgstr "Добавить стикеры"

#: src/ui/picker.rs:1185
msgid "Search by emoji, word, or pack"
msgstr "Поиск по эмодзи, слову или набору"

#: src/ui/picker.rs:1223
msgid "No stickers match your search."
msgstr "Нет стикеров по вашему запросу."

#: src/ui/picker.rs:1237
msgid "Loading your stickers…"
msgstr "Загрузка ваших стикеров…"

#: src/ui/picker.rs:1239
msgid "Stickers you send appear here."
msgstr "Здесь появляются стикеры, которые вы отправляете."

#: src/ui/picker.rs:1248
msgid ""
"Right-click any sticker to add it to your favorites. They stay in sync with "
"your phone."
msgstr ""
"Нажмите на любой стикер правой кнопкой, чтобы добавить его в избранное. "
"Избранное синхронизируется с телефоном."

#: src/ui/picker.rs:1264
msgid "Remove this pack"
msgstr "Удалить этот набор"

#: src/ui/picker.rs:1278
msgid "Send this pack to the chat"
msgstr "Отправить этот набор в чат"

#: src/ui/picker.rs:1292
msgid "Nothing here yet. Right-click any sticker to add it to this pack."
msgstr ""
"Здесь пока пусто. Нажмите на любой стикер правой кнопкой, чтобы добавить его "
"в этот набор."

#: src/ui/picker.rs:1365
msgid "Import a pack"
msgstr "Импортировать набор"

#: src/ui/picker.rs:1373
msgid ""
"Paste a signal.art link from signalstickers.org, or open a .wastickers file."
msgstr ""
"Вставьте ссылку signal.art с signalstickers.org или откройте "
"файл .wastickers."

#: src/ui/picker.rs:1383
msgid "Make your own"
msgstr "Создайте свои"

#: src/ui/picker.rs:1391
msgid ""
"Start a pack, then right-click any sticker to add it. Or turn a picture into "
"a sticker."
msgstr ""
"Создайте набор, затем нажмите на любой стикер правой кнопкой, чтобы добавить "
"его. Или превратите картинку в стикер."

#: src/ui/picker.rs:1403
msgid "Make a sticker from a picture…"
msgstr "Сделать стикер из картинки…"

#: src/ui/picker.rs:1418
msgid "Create pack"
msgstr "Создать набор"

#: src/ui/picker.rs:1429
msgid "New pack…"
msgstr "Новый набор…"

#: src/ui/picker.rs:1462
msgid "Find packs"
msgstr "Найти наборы"

#: src/ui/picker.rs:1463
msgid "Open file"
msgstr "Открыть файл"

#: src/ui/picker.rs:1478
msgid "Paste a signal.art link"
msgstr "Вставьте ссылку signal.art"

#: src/ui/picker.rs:1506
msgid "Browse signalstickers.org"
msgstr "Открыть signalstickers.org"

#: src/ui/picker.rs:1522
msgid "Importing the pack…"
msgstr "Импорт набора…"

#: src/ui/picker.rs:1571
msgid "Remove from recents"
msgstr "Убрать из недавних"

#: src/ui/pane.rs:123
msgid "Close search"
msgstr "Закрыть поиск"

#: src/ui/pane.rs:151 src/ui/pane.rs:329
msgid "Filter by date"
msgstr "Фильтр по дате"

#: src/ui/pane.rs:204
#, rust-format
msgid "Search messages with {}"
msgstr "Поиск сообщений в чате «{}»"

#: src/ui/pane.rs:227
msgid "No messages found"
msgstr "Сообщения не найдены"

#: src/ui/pane.rs:228
msgid "Try another word or pick a different day."
msgstr "Попробуйте другое слово или выберите другой день."

#: src/ui/pane.rs:255
#, rust-format
msgid "Only the newest {} matches are listed. Narrow the search or pick a day."
msgstr ""
"Показаны только {} самых новых совпадений. Уточните запрос или выберите день."

#: src/ui/pane.rs:344
msgid "Clear the day filter"
msgstr "Сбросить фильтр по дню"

#: src/ui/pane.rs:411
msgid "Next month"
msgstr "Следующий месяц"

#: src/ui/pane.rs:423
msgid "Previous month"
msgstr "Предыдущий месяц"

